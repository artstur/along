diff --git a/workspace.test.mjs b/workspace.test.mjs
index 86bef1b..eb1c16c 100644
--- a/workspace.test.mjs
+++ b/workspace.test.mjs
@@ -39,0 +40,8 @@ test('connected health sources show only selected additional aggregates',()=>{
+test('connected health sources expose selected sleep duration and steps',()=>{
+  const state=ensureHealthGoal(setSnapshot(initialState(),{
+    selectedTypes:['sleep','steps'],sleepMinutes:360,steps:1000,
+  },'healthkit'));
+  const metrics=healthView(state).connection.metrics;
+  assert.deepEqual(metrics.map(item=>item.label),['睡眠时长','今日步数']);
+  assert.deepEqual(metrics.map(item=>item.value),['6 小时','1,000 步']);
+});
