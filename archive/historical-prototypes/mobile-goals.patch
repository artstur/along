@@ -32,0 +33,8 @@ export function addFinanceDemoRecord(finance, target = FINANCE_TARGET) {
+function formatSleepDuration(minutes) {
+  if (minutes == null) return '无记录';
+  const hours=Math.floor(minutes/60), remainder=minutes%60;
+  if (!hours) return `${remainder} 分钟`;
+  if (!remainder) return `${hours} 小时`;
+  return `${hours} 小时 ${remainder} 分钟`;
+}
+
@@ -44,0 +53,2 @@ export function healthView(state, customization = null) {
+    selected?.includes('sleep') ? {label:'睡眠时长',value:formatSleepDuration(state.snapshot.sleepMinutes)} : null,
