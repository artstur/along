+++ b/health-companion.test.mjs
@@ -0,0 +1,22 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {healthCompanionDataset,healthTaskContext} from './health-companion.mjs';
+
+const connected={source:'healthkit',snapshot:{workoutMinutes:20,workoutCount:1,updatedAt:'2000-01-01T00:00:00Z',selectedTypes:['workout']}};
+
+test('builds distinct autonomous, reminder and recommendation tasks from grounded inputs',()=>{
+  const dataset=healthCompanionDataset(connected,100,{status:'scheduled'});
+  assert.deepEqual([...new Set(dataset.tasks.map(task=>task.kind))],['autonomous','reminder','recommendation']);
+  assert.match(dataset.tasks[0].detail,/20\/100/);
+  assert.equal(dataset.tasks[1].orchestration.status,'scheduled');
+  assert.equal(dataset.tasks[2].requestId,'fixture-health-activity');
+  assert.ok(dataset.tasks[2].orchestration.inputs.some(input=>input.id==='weather'));
+});
+
+test('keeps demo profile fields explicit and never invents missing HealthKit progress',()=>{
+  const dataset=healthCompanionDataset({source:null,snapshot:null},100,{});
+  assert.equal(dataset.snapshot.workoutMinutes,null);
