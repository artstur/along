index 0000000..343d3eb
--- /dev/null
+++ b/health-companion.mjs
@@ -0,0 +1,115 @@
+export const HEALTH_COMPANION_VERSION = 1;
+export const HEALTH_REMINDER_KEY = 'along.health-reminder.v1';
+
+const WEATHER_URL = 'https://example.org/archive/weather';
+const TRAIL_URL = 'https://example.org/archive/route';
+const WHO_URL = 'https://www.who.int/europe/publications/i/item/9789240014886';
+const SLEEP_URL = 'https://www.nhc.gov.cn/guihuaxxs/c100133/202503/70d5836afe804a858b899ee951a24a13.shtml';
+
+function workoutSnapshot(state, target) {
+  const selected=state?.snapshot?.selectedTypes;
+  const readable=state?.snapshot && Number.isFinite(state.snapshot.workoutMinutes) &&
+    (state.source!=='healthkit' || !Array.isArray(selected) || selected.includes('workout'));
+  const minutes=readable?state.snapshot.workoutMinutes:null;
+  return {
+    source:state?.source==='healthkit'?'Apple Health 最小摘要':state?.source==='demo'?'演示健康数据':'尚未连接',
+    capturedAt:state?.snapshot?.updatedAt||null,
+    workoutMinutes:minutes,
+    workoutCount:readable&&Number.isFinite(state.snapshot.workoutCount)?state.snapshot.workoutCount:null,
+    target,
+    remaining:minutes==null?null:Math.max(0,target-minutes),
+    percent:minutes==null?null:Math.min(100,Math.round(minutes/target*100)),
+  };
+}
+
+function healthEvidence(snapshot) {
+  const known=snapshot.workoutMinutes!=null;
+  return {
+    id:'apple-health', label:'Apple Health', kind:known?'connected':'needed',
+    detail:known?`本周 ${snapshot.workoutMinutes} 分钟 · ${snapshot.workoutCount??'—'} 次 · 目标 ${snapshot.target} 分钟`:'等待本周健身时长摘要',
+    capturedAt:snapshot.capturedAt,
+  };
+}
+
+function taskBase(value) {
+  return {state:'planned',...value,orchestration:{version:1,...value.orchestration}};
+}
+
+/**
+ * A transparent product scenario: connected summaries stay factual; visit history and
+ * preferences are explicitly labelled demo data until the user replaces them.
+ */
+export function healthCompanionDataset(state, target=100, reminder={}) {
+  const snapshot=workoutSnapshot(state,target);
+  const remaining=snapshot.remaining;
+  const progressKnown=remaining!=null;
+  const reviewResult=progressKnown
+    ? `已读取本周 ${snapshot.workoutMinutes}/${target} 分钟（${snapshot.percent}%），${remaining?`还差 ${remaining} 分钟`:'目标已达成'}。`
+    : '尚无可读取的本周健身时长，Agent 保持安静并等待数据。';
+  const reminderEnabled=reminder?.status==='scheduled';
+  const health=healthEvidence(snapshot);
+  const demoHistory={id:'demo-history',label:'合成活动档案',kind:'demo',detail:'测试选项 A'};
+  const visited={id:'visited-places',label:'合成地点记录',kind:'demo',detail:'地点 A 已访问，地点 B 待选'};
+  const weather={id:'weather',label:'测试天气',kind:'demo',url:WEATHER_URL,checkedAt:'2000-01-01T00:00:00Z',detail:'合成条件 A'};
+  const poi={id:'poi',label:'示例地点 B',kind:'demo',url:TRAIL_URL,checkedAt:'2000-01-01T00:00:00Z',detail:'合成路线 B'};
+  const activityGuidance={id:'who-activity',label:'WHO 活动指南',kind:'knowledge',url:WHO_URL,detail:'成人每周至少 150–300 分钟中等强度有氧活动；任何活动都比完全不活动更好'};
+  const sleepGuidance={id:'nhc-sleep',label:'国家卫健委睡眠信息',kind:'knowledge',url:SLEEP_URL,detail:'成年人一般需要 7–8 小时睡眠，规律入睡和起床时间有助于稳定节律'};
+
+  const tasks=[
+    taskBase({
+      id:'weekly-health-review',requestId:'fixture-health-review',kind:'autonomous',kindLabel:'Agent 自主完成',
+      when:'测试周期开始 · 数据刷新后',title:'本周节奏检查',
+      detail:reviewResult,state:progressKnown?'temporary':'deferred',
+      preview:progressKnown&&remaining>0?`不用临时突击，先保留 ${Math.min(remaining,30)} 分钟的轻量活动窗口。`:'有新记录时再计算，不凭空生成训练建议。',
+      orchestration:{runPolicy:'automatic',trigger:'周期到期或健身时长发生有意义变化',status:progressKnown?'ready':'waiting-data',
+        inputs:[health,activityGuidance],missing:progressKnown?[]:['本周健身时长'],
+        boundary:'可自主读取最小摘要并生成报告；不自动更改健康目标，不给医学诊断。'},
+    }),
+    taskBase({
+      id:'rest-reminder-fixture',kind:'reminder',kindLabel:'需要提醒你',when:'每天 14:15',
+      title:reminderEnabled?'休息提醒已开启':'在示例时刻提醒我休息',
+      detail:reminderEnabled?'已交给 iPhone 本地通知；即使 Along 没有打开也能触发。':'需要你允许 iPhone 通知，Along 才能真正发出提醒。',
+      preview:reminderEnabled?'下一次将在 14:15 提醒。':'提醒文案：“示例休息提醒。”',
+      orchestration:{runPolicy:'user-consent',trigger:'每天 14:15 的本地时间',status:reminderEnabled?'scheduled':'needs-consent',inputs:[sleepGuidance],
+        missing:['是否需要仅在工作日提醒'],boundary:'只安排本地通知；不存储睡眠诊断，不强制用户休息。'},
+    }),
+    taskBase({
+      id:'activity-fixture-recommendation',requestId:'fixture-health-activity',kind:'recommendation',kindLabel:'为你推荐',
+      when:'测试周期结束 · 条件更新后',title:'体验示例活动 B',
+      detail:'根据合成天气和地点记录，选择示例路线 B。',
+      preview:'主选活动 B，备用活动 C。',
+      orchestration:{runPolicy:'scheduled-agent',trigger:'测试天气条件就绪',status:'agent-ready',inputs:[health,demoHistory,visited,weather,poi],
+        missing:['真实历史到访地点','出发位置','可用时段','备选活动条件'],
+        boundary:'可联网查询天气与 POI 并生成推荐；不自动预订课程、发起导航或将演示档案当作真实历史。'},
+    }),
+    taskBase({
+      id:'sleep-knowledge',kind:'recommendation',kindLabel:'针对性知识',when:'测试周期内',
+      title:'为什么先固定上床时间',
+      detail:'当前没有可读取的睡眠时长，Along 不会生成“睡眠评分”。示例提醒使用独立的测试时刻。',
+      preview:'国家卫健委建议成年人通常保证 7–8 小时睡眠，并保持规律的入睡与起床时间。',
+      orchestration:{runPolicy:'recommendation',trigger:'睡眠数据缺失且存在晚睡提醒目标',status:'ready',inputs:[sleepGuidance],missing:['Apple Health 睡眠时长'],
+        boundary:'只提供权威来源的一般健康知识；不生成 Apple 睡眠评分，持续睡眠障碍应寻求专业帮助。'},
+    }),
+  ];
+
+  return {
+    version:HEALTH_COMPANION_VERSION,label:'合成健康样例 · 分层证据',snapshot,
+    disclosure:'Apple Health 摘要按实际连接显示；近四周运动、偏好与到访历史为产品演示数据，待用户确认后才可转为真实档案。',
+    tasks,
+    suggestedSources:[
+      {id:'calendar',name:'日历空闲时段',reason:'避免推荐与已有安排冲突',status:'recommended'},
+      {id:'maps',name:'地图 / POI 与到访历史',reason:'计算路程并排除已去过的地点',status:'recommended'},
+      {id:'weather',name:'实时天气与降水预报',reason:'在执行前二次复核户外条件',status:'online-evidence'},
+      {id:'classes',name:'备用活动目录',reason:'按预算、距离、时段和课程难度生成雨天备选',status:'recommended'},
+    ],
+  };
+}
+
+export function healthTaskContext(task,dataset) {
+  return {
+    dataset:{version:dataset.version,label:dataset.label,disclosure:dataset.disclosure},
+    connectedHealthSummary:dataset.snapshot,
+    taskOrchestration:task.orchestration,
+    outputRequirement:'输出时分开已验证事实、演示档案和待确认信息；不声称完成未执行的预订、导航或医疗行为。',
+  };
+}
