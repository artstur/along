# 自动部署器的配置（安装后落在 /etc/along-auto-deploy.env）。
#
# 这里是**路径与版本来源**，不含任何凭证：模型与桥接凭证走目标机现有的
# file secret（secrets/ 与 data/superagent/along/data/bridge-token），
# 部署器只负责在切换前核对它们仍指向预期位置。
#
# **调度不在机器上**：Multica 的每小时 wakeup 调起这台机的一次性部署入口
# （sudo systemctl start along-auto-deploy.service），那一次运行会重新读这个文件，
# 所以改完等下一轮即可生效。

# 工作区根目录：data/ 与 secrets/ 在它下面，compose 的 ../../data、../../secrets
# 指向的就是这里。
ALONG_DEPLOY_WORKSPACE=/home/ecs-user/workspace

# 定时任务以这个账号运行（单元里的 User=）。状态目录与版本记录必须归它所有：
# 以 root 跑 bootstrap 时会据此 chown，避免服务账号下一轮取锁 Permission denied。
ALONG_DEPLOY_STATE_USER=ecs-user

# 两个仓库的地址与分支。机器上的 SSH 密钥要有这两个仓库的读权限。
ALONG_DEPLOY_ALONG_URL=git@github.com:artstur/along.git
ALONG_DEPLOY_SUPERAGENT_URL=git@github.com:artstur/along-superagent.git
ALONG_DEPLOY_BRANCH=main

# 现场 checkout：只用来 fetch 与取对象，不作为构建上下文（构建上下文是干净的
# 发布目录）。现场 checkout 上的未提交改动不会影响部署。
ALONG_DEPLOY_ALONG_CHECKOUT=/home/ecs-user/workspace/along
ALONG_DEPLOY_SUPERAGENT_CHECKOUT=/home/ecs-user/workspace/along-superagent

# 编排文件（相对发布目录里的 along/ 根）。
ALONG_DEPLOY_COMPOSE_REL=deploy/docker-compose.cloud.yml

# 探活：Host 的 HTTPS 入口 + 容器健康状态 + 锚点跳板。
ALONG_DEPLOY_HEALTH_URL=https://127.0.0.1:4176/health
ALONG_DEPLOY_HEALTH_TIMEOUT=420

# 构建超时（秒）。Super Agent 镜像要装依赖，慢网下要给足。
ALONG_DEPLOY_BUILD_TIMEOUT=5400

# 保留几个发布目录（当前成功版本与上一成功版本必须留着，前者用于运行、
# 后者用于回退），其余连同它们独占的镜像标签一起清掉。
ALONG_DEPLOY_KEEP_RELEASES=2
