[Unit]
Description=Run one Along auto-deploy round (check upstream main, deploy if changed)
Documentation=file:///home/ecs-user/workspace/along/docs/host-cloud-deploy.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
# 用现场账号跑：它已经在 docker 组里，git 的读权限也在这把 SSH 密钥上。
User=ecs-user
Group=ecs-user
WorkingDirectory=-/home/ecs-user/workspace
EnvironmentFile=-/etc/along-auto-deploy.env
ExecStart=/usr/local/libexec/along/auto-deploy.sh run
# 构建 Super Agent 镜像要拉依赖，慢网下可能跑很久；超时按两小时算。
TimeoutStartSec=7200
NoNewPrivileges=true
PrivateTmp=true
# 一轮失败不重试：下一次调用（Multica 的每小时 wakeup）会重来，
# 失败轮次没有推进成功记录。
Restart=no

[Install]
WantedBy=multi-user.target
