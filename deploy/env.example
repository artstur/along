# Along 云端部署环境变量——deploy/docker-compose.yml environment 段的参考值
# （docs/cloud-deploy-multi-user.md §3.1/§4 M5）。本文件只含非敏感示例值（验收 #5）；
# 真实凭证一律放 /opt/along/secrets/*（compose secrets，0600，仓库外层），绝不写进这里、
# compose 文件、镜像或日志。
#
# 使用：部署时把下面的值写入 compose 的 environment（或直接按需修改 compose），
# 必改项只有 ALONG_TLS_CN；其余值与设计拍板一致，照抄即可。

# ---- host 服务 ----
ALONG_AGENT_STATE_DIR=/data                    # 容器内状态目录（bind 卷 ../../data/host 挂到这里）
ALONG_AGENT_HOST=0.0.0.0                       # 必配：容器内没有 en0，缺省会回退 127.0.0.1，443 映射打不通
ALONG_AGENT_PORT=4176                          # 容器内端口（宿主机 443 → 4176）
ALONG_DSH_RUNNER_URL=http://agent:3088         # compose 内网 agent（§3.5）；不设则走 Mac 本地 bridge
ALONG_RUNNER_TOKEN_FILE=/run/secrets/runner-token   # 设置了 ALONG_DSH_RUNNER_URL 就必须配，缺失拒绝启动
ALONG_TLS_CN=along.example.com                 # 必改：真实域名（必须与预签发叶证书的 DNS SAN 一致）
# 云端 TLS 不再现场自签：Host 读状态目录里的预签发 CA 叶证书
# （/data/tls/current → tls/releases/<serial>/，含 fullchain.pem、key.pem、root.crt），
# 缺证或链/SAN/用途/有效期/权限不合规则在监听前拒启。
# 证书目录契约与制作/核验工具见 docs/iphone-ca-profile-design.md §3.1/§4.1 与 tools/ca-profile.mjs。
ALONG_EVENT_INGEST=off                         # 云端 v1 不开新链路：/events /sync /notifications /sources 返回 503 属预期（验收 #10）
# 云端形态**不需要**额外开关：Host 以「配置了云端 Runner」（ALONG_DSH_RUNNER_URL）判定
# （docs/iphone-ca-profile-design.md §3.1），命中即读预签发 CA 叶证书（不现场自签）。
# 状态目录里必须有 users.json（多用户静态用户表）——配置了 runner 却缺它时 Host 拒绝启动。
# Tier 2 打开后 runner 服务仍留在 compose 里作为显式回退目标，所以这个判据照样成立；
# **不要**清掉 ALONG_DSH_RUNNER_URL——那会让 Host 静默退回现场自签（安全降级）。

# ---- host 服务，远程通知（可选）----
# 不部署远程通知时：删除下面三个值，并按 compose 注释同步删除 apns-key 的三处引用。
ALONG_APNS_KEY_FILE=/run/secrets/apns-key      # .p8 私钥，必须 prime256v1 且文件 0600（host/apns.mjs 校验）
ALONG_APNS_TEAM_ID=XXXXXXXXXX                  # 10 位大写字母数字，示例值
ALONG_APNS_KEY_ID=XXXXXXXXXX                   # 10 位大写字母数字，示例值

# ---- agent 服务 ----
ALONG_RUNNER_TOKEN_FILE=/run/secrets/runner-token
ALONG_MODEL_API_KEY_FILE=/run/secrets/model-credentials   # 单行 DeepSeek API key，runner 启动时读取
ALONG_DSH_VERSION=0.2.2-rc.5                   # 与 deploy/Dockerfile.agent 的 pin 一致，记录用

# ---- Tier 2：长驻 Super Agent 与新链路（§3.5，验证项 V-1）----
# Tier 2 打开时（§6.4 第 8 步）host 侧要加这三项，superagent 侧要加桥接凭证挂载：
# ALONG_EVENT_INGEST=on                       # 打开新链路：/events /sync /sync/ack /notifications 生效。
#                                             # 打开后 Host 的旧 DSH 分支（/super-agent/goals|tasks）返回 409「已切换新链路」。
# ALONG_SUPERAGENT_URL=http://127.0.0.1:3082 # 长驻 Super Agent 的回环地址。默认就是它，通常不用显式设。
#                                             # 与 superagent 共享网络命名空间，3082 不对外发布端口。
# ALONG_BRIDGE_TOKEN_FILE=/run/secrets/bridge-token
#                                             # Host 与 superagent 必须指向**同一份** 0600 的 32 字节 hex 文件。
#                                             # 未配置时新链路端点返回 503（属预期，不静默降级）。
# ALONG_MODEL_API_KEY_FILE=/run/secrets/model-credentials
#                                             # 长驻服务的模型密钥（file secret）。与 Tier 1 的 runner 共用同一份宿主文件。
#                                             # 启动脚本读出后注入进程环境；权限过宽即拒绝启动。
# ALONG_SUPERAGENT_SOURCE=https://github.com/artstur/along-superagent.git#<40位提交>
#                                             # 上游 bundle 的构建来源，默认钉在固定提交上（不指向本地工作区——
#                                             # 那个 HEAD 可变，而旧版探针恒答 200，Host 侦测不到装错版本）。
#                                             # 本地对着未推送的提交调试时指向相邻 checkout。
# 回退 = 把 ALONG_EVENT_INGEST 改回 off 并重启 host（Along Agent 业务库与 DSH 状态不清，BC-09-03/04）。
